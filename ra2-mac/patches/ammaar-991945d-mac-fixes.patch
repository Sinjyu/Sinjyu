+    // Optional multiplier for the "fastest" setting, read from the page URL
+    // (e.g. ?turbo=1.5 → 90 ticks/s). Only changes real-time pacing, never the
+    // simulation itself; clamped to [1, 4]. Absent/invalid → 1 (stock 60 ticks/s).
+    static readonly TURBO = GameSpeed.readTurbo();
+    private static readTurbo(): number {
+        try {
+            const raw = Number(new URLSearchParams(globalThis.location?.search ?? "").get("turbo"));
+            return Number.isFinite(raw) && raw > 1 ? Math.min(4, raw) : 1;
+        }
+        catch {
+            return 1;
+        }
